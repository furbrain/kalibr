#!/usr/bin/env python3
print("importing libraries")

import time, sys, os
import argparse
import cv2
import csv

import numpy as np
from rosbags.typesys import Stores, get_typestore

#structure
# dataset/cam0/TIMESTAMP.png
# dataset/camN/TIMESTAMP.png
# dataset/imu.csv

#setup the argument list
parser = argparse.ArgumentParser(description='Create a ROS bag using the images and imu data. '
                                 'Writes a ROS 1 bag if the output name ends in .bag, otherwise a ROS 2 bag directory.')
parser.add_argument('--folder',  metavar='folder', nargs='?', help='Data folder')
parser.add_argument('--output-bag', metavar='output_bag',  default="output.bag", help='Output bag %(default)s')
parser.add_argument('--storage', choices=['sqlite3', 'mcap'], default='sqlite3', help='ROS 2 storage format %(default)s')

#print help if no argument is specified
if len(sys.argv)<2:
    parser.print_help()
    sys.exit(0)

#parse the args
parsed = parser.parse_args()

def getImageFilesFromDir(dir):
    '''Generates a list of files from the directory'''
    image_files = list()
    timestamps = list()
    if os.path.exists(dir):
        for path, names, files in os.walk(dir):
            for f in files:
                if os.path.splitext(f)[1] in ['.bmp', '.png', '.jpg']:
                    image_files.append( os.path.join( path, f ) )
                    timestamps.append(os.path.splitext(f)[0]) 
    #sort by timestamp
    sort_list = sorted(zip(timestamps, image_files))
    image_files = [file[1] for file in sort_list]
    return image_files

def getCamFoldersFromDir(dir):
    '''Generates a list of all folders that start with cam e.g. cam0'''
    cam_folders = list()
    if os.path.exists(dir):
        for path, folders, files in os.walk(dir):
            for folder in folders:                
                if folder[0:3] == "cam":
                    cam_folders.append(folder)
    return cam_folders

def getImuCsvFiles(dir):
    '''Generates a list of all csv files that start with imu'''
    imu_files = list()
    if os.path.exists(dir):
        for path, folders, files in os.walk(dir):
            for file in files:
                if file[0:3] == 'imu' and os.path.splitext(file)[1] == ".csv":
                    imu_files.append( os.path.join( path, file ) )
    
    return imu_files

ROS1 = parsed.output_bag.endswith('.bag')
typestore = get_typestore(Stores.ROS1_NOETIC if ROS1 else Stores.ROS2_HUMBLE)
Image = typestore.types['sensor_msgs/msg/Image']
Imu = typestore.types['sensor_msgs/msg/Imu']
Header = typestore.types['std_msgs/msg/Header']
Time = typestore.types['builtin_interfaces/msg/Time']
Quaternion = typestore.types['geometry_msgs/msg/Quaternion']
Vector3 = typestore.types['geometry_msgs/msg/Vector3']

def makeHeader(timestamp_ns, frame_id):
    stamp = Time(sec=timestamp_ns // 1000000000, nanosec=timestamp_ns % 1000000000)
    if ROS1:
        return Header(seq=0, stamp=stamp, frame_id=frame_id)
    return Header(stamp=stamp, frame_id=frame_id)

def serialize(msg):
    if ROS1:
        return typestore.serialize_ros1(msg, msg.__msgtype__)
    return typestore.serialize_cdr(msg, msg.__msgtype__)

def loadImageToRosMsg(filename, cam_name):
    image_np = cv2.imread(filename, cv2.IMREAD_GRAYSCALE)

    timestamp = int(os.path.splitext(os.path.basename(filename))[0])

    rosimage = Image(
        header=makeHeader(timestamp, cam_name),
        height=image_np.shape[0],
        width=image_np.shape[1],
        encoding="mono8",
        is_bigendian=0,
        step=image_np.shape[1],  #only with mono8! (step = width * byteperpixel * numChannels)
        data=np.ascontiguousarray(image_np).reshape(-1))

    return rosimage, timestamp

def createImuMessge(timestamp_int, omega, alpha, imu_name):
    timestamp = int(timestamp_int)
    zero_cov = np.zeros(9, dtype=np.float64)

    rosimu = Imu(
        header=makeHeader(timestamp, imu_name),
        orientation=Quaternion(x=0.0, y=0.0, z=0.0, w=1.0),
        orientation_covariance=zero_cov,
        angular_velocity=Vector3(x=float(omega[0]), y=float(omega[1]), z=float(omega[2])),
        angular_velocity_covariance=zero_cov,
        linear_acceleration=Vector3(x=float(alpha[0]), y=float(alpha[1]), z=float(alpha[2])),
        linear_acceleration_covariance=zero_cov)

    return rosimu, timestamp

class BagWriter(object):
    def __init__(self, path):
        if ROS1:
            from rosbags.rosbag1 import Writer
            self.writer = Writer(path)
        else:
            from rosbags.rosbag2 import Writer, StoragePlugin
            plugin = StoragePlugin.MCAP if parsed.storage == 'mcap' else StoragePlugin.SQLITE3
            self.writer = Writer(path, version=9, storage_plugin=plugin)
        self.writer.open()
        self.connections = {}

    def write(self, topic, msg, timestamp):
        if topic not in self.connections:
            self.connections[topic] = self.writer.add_connection(topic, msg.__msgtype__, typestore=typestore)
        self.writer.write(self.connections[topic], timestamp, serialize(msg))

    def close(self):
        self.writer.close()

#create the bag
bag = BagWriter(parsed.output_bag)
try:
    
    #write images
    camfolders = getCamFoldersFromDir(parsed.folder)
    for camfolder in camfolders:
        camdir = parsed.folder + "/{0}".format(camfolder)
        image_files = getImageFilesFromDir(camdir)
        for image_filename in image_files:
            image_msg, timestamp = loadImageToRosMsg(image_filename, camfolder)
            bag.write("/{0}/image_raw".format(camfolder), image_msg, timestamp)

    #write imu data
    imufiles = getImuCsvFiles(parsed.folder)
    for imufile in imufiles:
        topic = os.path.splitext(os.path.basename(imufile))[0]
        with open(imufile, 'r') as csvfile:
            reader = csv.reader(csvfile, delimiter=',')
            headers = next(reader, None)
            for row in reader:
                imumsg, timestamp = createImuMessge(row[0], row[1:4], row[4:7], topic)
                bag.write("/{0}".format(topic), imumsg, timestamp)
finally:
    bag.close()

